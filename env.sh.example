#!/bin/bash
# Machine-specific configuration. Copy to env.sh (git-ignored) and edit.
#   cp env.sh.example env.sh && $EDITOR env.sh
# Every scripts/*.sh sources this via scripts/lib.sh.

# --- interpreter -------------------------------------------------------------
# Needs torch 2.9 / transformers 4.57 / vllm 0.12. The `rl` conda env has them.
# It is fragile (mixed torch dist-info, cu12+cu13 wheels): never `pip install`
# anything in it that resolves torch.
export TIM_PY="${TIM_PY:-/scratch/users/akshay_anand/conda/envs/rl/bin/python}"
# Node-local mirror, preferred automatically when present (NFS reads from the
# compute nodes collapsed on 2026-09-28: 690 s to import torch from /scratch).
export TIM_PY_LOCAL="${TIM_PY_LOCAL:-/data/$USER/envs/rl_node/bin/python}"

# --- artifacts ---------------------------------------------------------------
# NOT $HOME (10G quota, ~2G free) and NOT /scratch. /data is node-local and
# unquota'd; other nodes see it as /net/<node>/data.
export TIM_DATA_ROOT="${TIM_DATA_ROOT:-/data/$USER/mismatch}"

# --- models ------------------------------------------------------------------
# Qwen3-1.7B / 4B / 8B are cached on horton. Set TIM_MODEL_ID for a single run;
# scripts/02_score.sh sweeps TIM_MODELS.
export TIM_MODEL_ID="${TIM_MODEL_ID:-Qwen/Qwen3-1.7B}"
export TIM_MODELS="${TIM_MODELS:-Qwen/Qwen3-1.7B Qwen/Qwen3-8B}"

# --- HuggingFace cache -------------------------------------------------------
export HF_HOME="${HF_HOME:-/data/$USER/huggingface-cache}"
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
export HF_DATASETS_OFFLINE="${HF_DATASETS_OFFLINE:-1}"
# .bashrc exports deprecated vars that shadow HF_HOME / hang datasets>=4.
unset TRANSFORMERS_CACHE HF_DATASETS_CACHE

# --- SLURM (slurm/submit.sh) -------------------------------------------------
export TIM_SLURM_PARTITION="${TIM_SLURM_PARTITION:-berkeleynlp}"
# normal is the LOWEST QOS on this cluster; preemptive is the ceiling we use.
export TIM_SLURM_QOS="${TIM_SLURM_QOS:-preemptive}"
# Models are cached on horton only (1.7B/4B). `-` so an explicit empty value
# means "float" once artifacts are staged to another node.
export TIM_SLURM_NODELIST="${TIM_SLURM_NODELIST-horton}"
export TIM_SLURM_EXCLUDE="${TIM_SLURM_EXCLUDE:-thidwick}"   # unusable mount (52 min imports)
export TIM_SLURM_CPUS="${TIM_SLURM_CPUS:-16}"
export TIM_SLURM_TIME="${TIM_SLURM_TIME:-6:00:00}"
export TIM_MAX_GPUS="${TIM_MAX_GPUS:-4}"                    # hard etiquette cap, enforced

# --- knobs -------------------------------------------------------------------
export TIM_MIN_FREE_MIB="${TIM_MIN_FREE_MIB:-60000}"        # GPUs are oversubscribed; wait
export TIM_SAMPLE_N="${TIM_SAMPLE_N:-512}"                  # prompts for the measurement corpus
export TIM_SAMPLE_MAXTOK="${TIM_SAMPLE_MAXTOK:-2048}"
export TIM_VLLM_CACHE="${TIM_VLLM_CACHE:-}"                 # default $TIM_DATA_ROOT/vllm-cache
# TIM_QUIET_ENV=1 silences the "no env.sh" notice (set by slurm/submit.sh).
# Stage-2 driver filters (optional): TIM_ONLY=view1,view2  TIM_SKIP=view3  TIM_LIMIT=64
# TIM_PY_RESOLVED is an OUTPUT of scripts/lib.sh (the interpreter it picked).
# Stage 4: TIM_GRPO_STEPS (default 200), TIM_STOP_AFTER_SEC (checkpoint+requeue budget)
# TIM_CAP_OVERRIDE=1 lets slurm/submit.sh proceed when squeue itself fails (never to exceed the cap).
